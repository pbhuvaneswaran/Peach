{
  "version": 2,
  "buildCommand": "npm install && cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/blog", "destination": "https://www.gotopeach.com/blog/peach" },
    { "source": "/blog/:slug", "destination": "https://www.gotopeach.com/blog/peach/:slug" },
    { "source": "/blog/:path*", "destination": "/api/index" }
  ]
}
